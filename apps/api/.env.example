# Copy to apps/api/.env and fill in real values. Never commit .env.
# Every value below is a placeholder.

# HTTP port for the API (Next.js uses 3000 by default).
PORT=3001

# Allowed CORS origin (the web app).
WEB_ORIGIN=http://localhost:3000

# Runtime connection used by the API (long-running NestJS process).
# Use the Supabase Supavisor SESSION pooler (port 5432).
# The TRANSACTION pooler (port 6543, with ?pgbouncer=true) is only meant for
# serverless / short-lived functions; do not use it for this API.
DATABASE_URL="postgresql://prisma.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Connection used by Prisma CLI for migrations (prisma migrate dev/deploy).
# Use the DIRECT connection (db.[PROJECT-REF].supabase.co:5432, requires IPv6
# or the IPv4 add-on) or, alternatively, the same session pooler on port 5432.
DIRECT_URL="postgresql://prisma:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
