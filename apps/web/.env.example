# Copy to apps/web/.env.local for local development. Never commit real values.
# All of these are server-side only (no NEXT_PUBLIC_ prefix).

# La Livre API base URL. On Vercel it is injected by the service binding
# (vercel.json). Locally: http://localhost:3001. Unset: in-memory demo catalog.
API_INTERNAL_URL=
# Shared secret sent as "Authorization: Bearer <token>"; same value as
# API_INTERNAL_TOKEN in apps/api.
API_INTERNAL_TOKEN=

# HMAC secret for the session cookie (required in production).
SESSION_SECRET=

# Mock account previews (set to 1 to enable; LALIVRE_MOCK_ZONE=AMBA).
LALIVRE_MOCK_ZONE=
LALIVRE_MOCK_SUSPENDED=
LALIVRE_MOCK_ORDER_LOCKED=
LALIVRE_MOCK_NO_PROMOTIONS=
LALIVRE_MOCK_NO_CONSIGNMENT=
# Show the demo credentials hint on the login page outside development (1).
LALIVRE_SHOW_DEMO_HINT=
